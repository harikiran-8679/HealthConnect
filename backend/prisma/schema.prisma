generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int             @id @default(autoincrement())
  name             String
  email            String          @unique
  phone            String?
  passwordHash     String          @map("password_hash")
  role             String          @default("user")
  preferredLanguage String?        @map("preferred_language")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  familyMembers    FamilyMember[]

  @@map("users")
}

model FamilyMember {
  id             Int                   @id @default(autoincrement())
  userId         Int                   @map("user_id")
  name           String
  dateOfBirth    DateTime              @map("date_of_birth")
  relation       String
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  records        VaccinationRecord[]

  @@index([userId])
  @@map("family_members")
}

model VaccinationScheduleTemplate {
  id               Int                   @id @default(autoincrement())
  vaccineName      String                @map("vaccine_name")
  recommendedAgeDays Int                 @map("recommended_age_days")
  description      String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  records          VaccinationRecord[]

  @@map("vaccination_schedule_templates")
}

model VaccinationRecord {
  id             Int                       @id @default(autoincrement())
  familyMemberId Int                       @map("family_member_id")
  vaccineId      Int                       @map("vaccine_id")
  dueDate        DateTime                  @map("due_date")
  status         String                    @default("pending")
  completedDate  DateTime?                 @map("completed_date")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  familyMember   FamilyMember              @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  vaccine        VaccinationScheduleTemplate @relation(fields: [vaccineId], references: [id])

  @@index([familyMemberId])
  @@index([vaccineId])
  @@map("vaccination_records")
}

model HealthTip {
  id          Int                    @id @default(autoincrement())
  category    String
  imageUrl    String?                @map("image_url")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  translations HealthTipTranslation[]

  @@index([category])
  @@map("health_tips")
}

model HealthTipTranslation {
  id          Int       @id @default(autoincrement())
  healthTipId Int       @map("health_tip_id")
  languageCode String   @map("language_code")
  title       String
  description String
  healthTip   HealthTip @relation(fields: [healthTipId], references: [id], onDelete: Cascade)

  @@unique([healthTipId, languageCode])
  @@index([languageCode])
  @@map("health_tip_translations")
}

model Disease {
  id          Int                    @id @default(autoincrement())
  name        String
  imageUrl    String?                @map("image_url")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  translations DiseaseTranslation[]

  @@map("diseases")
}

model DiseaseTranslation {
  id          Int       @id @default(autoincrement())
  diseaseId   Int       @map("disease_id")
  languageCode String   @map("language_code")
  symptoms    String
  prevention  String
  careTips    String    @map("care_tips")
  disease     Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, languageCode])
  @@index([languageCode])
  @@map("disease_translations")
}

model EmergencyContact {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  type        String
  state       String?
  district    String?
  village     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([state])
  @@map("emergency_contacts")
}

model WomenChildContent {
  id          Int                          @id @default(autoincrement())
  category    String
  imageUrl    String?                      @map("image_url")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  translations WomenChildContentTranslation[]

  @@index([category])
  @@map("women_child_content")
}

model WomenChildContentTranslation {
  id          Int              @id @default(autoincrement())
  contentId   Int              @map("content_id")
  languageCode String          @map("language_code")
  title       String
  body        String
  content     WomenChildContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, languageCode])
  @@index([languageCode])
  @@map("women_child_content_translations")
}

model Language {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  @@map("languages")
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@index([path])
  @@index([viewedAt])
  @@map("page_views")
}
